# Python
__pycache__/
*.py[cod]
*.egg-info/
.ipynb_checkpoints/
.pytest_cache/

# Virtual environment
.venv/
venv/
env/

# Environment variables / secrets (e.g. ENTSO-E API key)
.env
*.env.local

# Data — regenerated via scripts, not committed
data/raw/**
data/processed/**
!data/raw/.gitkeep
!data/processed/.gitkeep

# Docs - notes for the project
data/notes/**

# dbt
dbt/**/target/
dbt/**/dbt_packages/
dbt/**/logs/
dbt/**/.user.yml

# DuckDB database file (regenerated from dbt build)
*.duckdb
*.duckdb.wal

# Jupyter
*.ipynb_checkpoints

# VS Code (keep shared settings, ignore personal workspace state)
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json

# OS files
.DS_Store
Thumbs.db

# Tableau (workbooks can be large; keep only what you intend to publish)
*.twbx
*.hyper
